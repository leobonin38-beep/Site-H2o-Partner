---
import { fr } from '../../lib/typo';
import { url } from '../../lib/url';
// Textes repris de la V2 (page Particuliers, « Comment l'eau devient douce »).
const steps = [
  { t: "L'eau dure arrive", d: "L'eau du réseau transporte du calcium et du magnésium. Plus elle en contient, plus elle est « dure » : c'est ce que mesure le TH, en degrés français (°f)." },
  { t: 'La résine échange les ions', d: "En traversant la résine échangeuse d'ions, l'eau cède son calcium et son magnésium, remplacés par du sodium. Les résines sont agréées pour une application alimentaire." },
  { t: "L'eau adoucie alimente la maison", d: "Canalisations, robinets, chauffe-eau et électroménager sont protégés du tartre. L'eau adoucie reste potable." },
  { t: 'La résine se régénère', d: 'Quand la résine est saturée, une saumure préparée dans le bac à sel la nettoie, puis l’eau de rinçage part à l’égout.' },
];
---
<section id="adoucissement" class="seq dark" data-sequence data-src={url('/sequences/softener/')}>
  <div class="stage">
    <div class="wrap layout">
      <header class="head">
        <h2>Comment l'eau devient douce.</h2>
        <p class="muted">Un adoucisseur ne dissout pas le calcaire : il remplace les ions calcium et magnésium de l'eau par des ions sodium.</p>
      </header>
      <div class="visual">
        <canvas width="1600" height="900" aria-hidden="true" data-seq-canvas></canvas>
        <img class="fallback" src={url('/sequences/softener/fallback.webp')} width="1600" height="900" alt="Coupe schématique d'un adoucisseur : l'eau traverse la résine, qui retient le calcaire" loading="lazy" decoding="async" data-seq-fallback />
        <p class="note">Schéma animé, valeurs données à titre d'exemple.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-seq-step={i}>
            <span class="n num">{i + 1}</span>
            <div><h3>{fr(s.t)}</h3><p class="muted">{fr(s.d)}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { initSequence } from '../../scripts/sequence';
  initSequence();
</script>

<style>
  .seq { background: var(--night); position: relative; }
  .stage { padding: clamp(80px, 9vw, 140px) 0; }
  .layout { display: grid; grid-template-columns: 4fr 8fr; grid-template-areas: 'head visual' 'steps visual'; gap: 32px clamp(32px, 5vw, 80px); align-items: start; }
  .head { grid-area: head; }
  .head p { margin-top: 18px; max-width: 40ch; }
  .visual { grid-area: visual; position: relative; }
  canvas, .fallback { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius); background: var(--night-2); }
  canvas { display: none; }
  .note { font-size: var(--t-xs); color: var(--on-dark-muted); margin-top: 10px; }
  .steps { grid-area: steps; list-style: none; padding: 0; border-top: 1px solid var(--line-dark); }
  .steps li { display: grid; grid-template-columns: 44px 1fr; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--line-dark); transition: opacity .4s; }
  .n { font-family: var(--f-display); font-size: 1.375rem; color: var(--accent); line-height: 1.1; }
  h3 { font-family: var(--f-body); font-size: 1.0625rem; font-weight: 600; letter-spacing: 0; line-height: 1.35; }
  .steps p { font-size: var(--t-sm); margin-top: 4px; }

  /* Mode animé : canvas à la place de l'image fixe (dès que la 1re image est chargée) */
  :global(.seq-live) canvas { display: block; }
  :global(.seq-live) .fallback { display: none; }
  :global(.seq-live) .steps li { opacity: .55; }
  :global(.seq-live) .steps li.on { opacity: 1; }

  /* Mode épinglé (ordinateur, si la scène tient dans l'écran) : posé par le script avant la mesure */
  @media (min-width: 901px) {
    :global(.seq-pin) .stage { min-height: 100vh; display: flex; align-items: center; padding: calc(var(--header-h) * .5) 0 20px; }
    :global(.seq-pin) .layout { width: min(var(--max), 100% - 2 * var(--gutter)); row-gap: 24px; }
    :global(.seq-pin) .steps li { padding: 11px 0; }
    :global(.seq-pin) .visual { align-self: center; }
    :global(.seq-pin) canvas, :global(.seq-pin) .fallback { width: auto; max-width: 100%; max-height: calc(100vh - 140px); margin-inline: auto; }
  }
  @media (min-width: 901px) and (max-height: 820px) {
    :global(.seq-pin) .head p { display: none; }
    :global(.seq-pin) .head h2 { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem); }
    :global(.seq-pin) .steps p { font-size: var(--t-xs); line-height: 1.45; }
    :global(.seq-pin) .steps li { padding: 9px 0; }
  }

  /* Téléphone : image fixée en haut pendant que les étapes défilent dessous */
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; grid-template-areas: 'head' 'visual' 'steps'; }
    canvas { aspect-ratio: 3 / 4; }
    .fallback { aspect-ratio: 16 / 9; object-fit: contain; }
    :global(.seq-live) .visual { position: sticky; top: 8px; z-index: 1; background: var(--night); padding-bottom: 8px; }
    :global(.seq-live) canvas { width: auto; height: min(52svh, 520px); margin-inline: auto; }
    :global(.seq-live) .steps { padding-bottom: 30svh; }
  }
</style>
