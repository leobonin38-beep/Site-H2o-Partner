---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import { url } from '../lib/url';
---
<a class="logo" href={url('/')} aria-label="H2O Partner, retour à l'accueil">
  <Image src={logo} alt="H2O Partner, votre équipier du traitement de l'eau" width={148} densities={[1, 2]} loading="eager" />
</a>
<style>
  .logo { display: block; background: #fff; padding: 7px 9px; border-radius: var(--radius); line-height: 0; flex: none; }
  .logo img { width: 128px; height: auto; }
  @media (max-width: 640px) { .logo img { width: 104px; } }
</style>
