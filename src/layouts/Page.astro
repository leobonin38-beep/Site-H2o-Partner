---
// Gabarit des pages intérieures : SEO, fil d'Ariane (JSON-LD), prestation éventuelle.
import Base from './Base.astro';
import { breadcrumbLd, localBusinessLd, serviceLd } from '../lib/schema';
interface Props {
  title: string; description: string; path: string;
  crumbs: { name: string; href: string }[];
  service?: { name: string; description: string };
  ld?: object[];
  suffix?: boolean;
}
const { title, description, path, crumbs, service, ld = [], suffix = true } = Astro.props;
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const all = [breadcrumbLd(site, [{ name: 'Accueil', href: '/' }, ...crumbs]), ...(service ? [serviceLd(site, { ...service, href: path })] : []), ...ld];
if (service) all.push(localBusinessLd(site));
---
<Base title={title} description={description} path={path} ld={all} overDark suffix={suffix}>
  <slot />
</Base>
