---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/page/PageHero.astro';
import Section from '../../components/page/Section.astro';
import Split from '../../components/page/Split.astro';
import Features from '../../components/page/Features.astro';
import StepsRail from '../../components/page/StepsRail.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Related from '../../components/page/Related.astro';
import hero from '../../assets/photos/technicien-chaudiere.jpg';
import labo from '../../assets/photos/analyse-laboratoire.jpg';
const crumbs = [{ name: 'Entretien & SAV', href: '/entretien-sav/' }];
---
<Page title="Entretien d'adoucisseur et SAV en Isère" description="Entretien annuel d'adoucisseur, eaux de source et de forage, pompes doseuses, circuits de chauffage et installations industrielles : SAV et garantie en direct." path="/entretien-sav/" crumbs={crumbs}
  service={{ name: "Entretien et SAV des équipements de traitement de l'eau", description: "Entretien annuel des adoucisseurs, des traitements d'eau de source et de forage, des pompes doseuses et des installations industrielles." }}>
  <PageHero title="Entretien de vos équipements." crumbs={crumbs} photo={hero} alt="Technicien intervenant sur une chaudière"
    lead="Société spécialisée, nous assurons l'entretien pour chaque utilisateur : particulier, copropriété, tertiaire, industrie. Entretien, SAV et garantie en direct, sur le matériel que nous avons fourni."
    anchors={[{ label: 'Ce que nous entretenons', href: '#equipements' }, { label: "L'entretien annuel", href: '#annuel' }]} cta={{ label: 'Demander un entretien', href: '/contact/' }} />

  <Section id="equipements" title="Ce que nous entretenons.">
    <Features cols={3} items={[
      { t: 'Votre adoucisseur', d: 'Privilège, Petit Privilège, CLACK : réglages, bac à sel, résines et cycles, au moins une fois par an.' },
      { t: 'Les eaux de source et de forage', d: 'MES, manganèse, fer, ammonium, calcaire et bactéries (UVc ou chloration).' },
      { t: 'Les pompes doseuses', d: "Chloration ou filmogène pour l'eau chaude sanitaire." },
      { t: 'Les circuits de chauffage', d: 'Suivi des produits de conditionnement des circuits.' },
      { t: 'Les installations industrielles', d: 'Adoucisseurs TWIN ou DUPLEX, osmoseurs, eau déminéralisée.' },
    ]} />
  </Section>

  <Section id="annuel" tone="dark" title="L'entretien annuel de l'adoucisseur." intro="Comme une chaudière, un adoucisseur doit être entretenu au moins une fois par an par un professionnel : de quoi garantir le bon fonctionnement de l'appareil et la qualité bactériologique de l'eau.">
    <div class="ann">
      <StepsRail items={[
        { t: 'Vérification des réglages', d: "Dureté d'entrée et de sortie, programmation de la vanne." },
        { t: 'Nettoyage du bac à sel et des résines', d: 'Avec un sel de régénération conforme à la norme NF EN 973.' },
        { t: 'Contrôle des cycles hydrauliques', d: "Régénération, rinçage, rejet à l'égout." },
      ]} />
      <p class="gar">La garantie de 5 ans sur votre adoucisseur s'applique dans le cadre de cet entretien annuel.</p>
    </div>
  </Section>

  <Section tone="paper">
    <Split photo={labo} alt="Analyse d'échantillons d'eau en laboratoire" caption="Photo d'illustration.">
      <h2 data-reveal-text>Des analyses à l'appui.</h2>
      <p class="lead muted">Quand c'est utile, les analyses d'eau sont confiées à un laboratoire accrédité COFRAC.</p>
      <p class="muted">Nos techniciens se déplacent en Isère et en Rhône-Alpes.</p>
    </Split>
  </Section>

  <CtaBand title="Demander un entretien." text="Indiquez-nous votre matériel et votre commune : nous convenons d'un passage." label="Demander un entretien" href="/contact/" />
  <Related items={[
    { label: 'Vrai ou faux', desc: "L'entretien annuel est-il obligatoire ?", href: '/particuliers/verite-sur-adoucisseur/' },
    { label: 'Les adoucisseurs Privilège', desc: 'Garantie 5 ans avec entretien annuel', href: '/particuliers/adoucisseur-privilege/' },
    { label: 'Industrie', desc: 'Maintenance des installations de process', href: '/industrie/' },
  ]} />
</Page>
<style>
  .ann { display: grid; grid-template-columns: 7fr 4fr; gap: 48px; align-items: end; }
  .gar { font-family: var(--f-display); font-size: var(--t-xl); line-height: 1.25; border-top: 2px solid var(--accent); padding-top: 18px; }
  @media (max-width: 900px) { .ann { grid-template-columns: 1fr; } }
</style>
