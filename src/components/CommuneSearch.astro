---
// Recherche de commune (combobox accessible). mode « navigate » : ouvre la page de la commune ;
// mode « ruler » : règle la règle de dureté de la page et affiche un résumé.
import { url } from '../lib/url';
interface Props { mode?: 'navigate' | 'ruler'; id: string; label?: string }
const { mode = 'navigate', id, label = 'Votre commune ou code postal' } = Astro.props;
---
<div class="cs" data-commune-search data-mode={mode} data-index={url('/data/durete-index.json')} data-base={url('/durete-eau-isere/')}>
  <label for={id}>{label}</label>
  <div class="box">
    <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m13 13 5 5" stroke="currentColor" stroke-width="1.6"/></svg>
    <input id={id} type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-list`} autocomplete="off" spellcheck="false" placeholder="Ex. Voiron, 38500" />
    <ul id={`${id}-list`} role="listbox" aria-label="Communes trouvées" hidden></ul>
  </div>
  <p class="status" aria-live="polite" data-cs-status></p>
  {mode === 'ruler' && <p class="result" data-commune-result hidden></p>}
  <noscript><p class="nojs"><a href={url('/durete-eau-isere/')}>Voir la dureté de toutes les communes d'Isère</a></p></noscript>
</div>
<script>
  import { initCommuneSearch } from '../scripts/commune-search';
  initCommuneSearch();
</script>
<style>
  .cs { position: relative; }
  label { display: block; font-weight: 600; font-size: var(--t-sm); margin-bottom: 8px; }
  .box { position: relative; }
  .box svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  input { width: 100%; min-height: 52px; padding: 12px 14px 12px 42px; font-size: 1.0625rem; border: 1px solid rgba(21, 28, 32, .28); border-radius: var(--radius); background: var(--paper); color: var(--ink); }
  input:focus { outline: none; border-color: var(--accent-strong); box-shadow: 0 0 0 3px rgba(168, 105, 42, .22); }
  ul { position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px); list-style: none; padding: 6px 0; margin: 0; background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 16px 40px rgba(0, 0, 0, .18); max-height: 340px; overflow-y: auto; }
  :global([data-commune-search] [role='option']) { display: flex; justify-content: space-between; gap: 16px; padding: 10px 14px; cursor: pointer; }
  :global([data-commune-search] [role='option'][aria-selected='true']), :global([data-commune-search] [role='option']:hover) { background: var(--day); }
  :global([data-commune-search] .o-name) { font-weight: 600; }
  :global([data-commune-search] .o-cp) { color: var(--muted); font-weight: 400; margin-left: 6px; }
  :global([data-commune-search] .o-th) { color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .status { min-height: 1.4em; margin-top: 8px; font-size: var(--t-sm); color: var(--muted); }
  .result { margin-top: 4px; padding: 14px 16px; background: var(--day); border-left: 3px solid var(--accent-strong); border-radius: var(--radius); }
</style>
