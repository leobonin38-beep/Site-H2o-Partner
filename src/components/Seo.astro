---
import { SITE } from '../config/site';
import { url } from '../lib/url';
interface Props { title: string; description: string; path: string; ld?: object[]; ogImage?: string; noindex?: boolean }
const { title, description, path, ld = [], ogImage = '/og-default.jpg', noindex = false } = Astro.props;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const canonical = new URL(path.replace(/^\//, ''), site).href;
const og = new URL(url(ogImage).replace(/^\//, ''), Astro.site).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!indexable && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
