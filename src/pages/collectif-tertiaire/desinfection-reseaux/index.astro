---
import Page from '../../../layouts/Page.astro';
import PageHero from '../../../components/page/PageHero.astro';
import Section from '../../../components/page/Section.astro';
import Split from '../../../components/page/Split.astro';
import StepsRail from '../../../components/page/StepsRail.astro';
import railPic from '../../../assets/photos/robinet-goutte-marbre.jpg';
import CtaBand from '../../../components/page/CtaBand.astro';
import Related from '../../../components/page/Related.astro';
import hero from '../../../assets/photos/analyse-tubes.jpg';
import labo from '../../../assets/photos/analyse-laboratoire.jpg';
const crumbs = [{ name: 'Collectif & tertiaire', href: '/collectif-tertiaire/' }, { name: 'Désinfection des réseaux', href: '/collectif-tertiaire/desinfection-reseaux/' }];
---
<Page title="Désinfection des réseaux d'eau EFS et ECS" description="Désinfection des réseaux d'eau froide et chaude (EFS, ECS) selon le protocole ARS, validée par un laboratoire accrédité COFRAC. Ehpad, hôpitaux, hôtels." path="/collectif-tertiaire/desinfection-reseaux/" crumbs={crumbs}
  service={{ name: 'Désinfection sanitaire des réseaux EFS et ECS', description: "Désinfection préventive ou curative des réseaux d'eau froide et chaude sanitaire, selon le protocole ARS, avec analyses COFRAC." }}>
  <PageHero title="Désinfection sanitaire EFS et ECS." crumbs={crumbs} photo={hero} alt="Tubes d'échantillons d'eau prêts pour l'analyse"
    lead="En préventif après travaux neufs ou en curatif : Ehpad, hôpitaux, cantines, restaurants universitaires, hôtels, gymnases, clubs de vacances…"
    cta={{ label: 'Demander un devis de prestation', href: '/diagnostic/' }} />
  <Section tone="dark" title="Le protocole, étape par étape.">
    <StepsRail photo={railPic} alt="Goutte d'eau au bout d'un robinet" items={[
      { t: 'Protocole ARS', d: 'Injection de chlore ou de peroxyde d’hydrogène selon les matériaux en présence.' },
      { t: 'Contact', d: 'Concentration et durée de contact contrôlées par analyse sur l’ensemble des points d’eau.' },
      { t: 'Rinçage', d: 'Contrôlé et analysé sur l’ensemble des points.' },
      { t: 'Validation', d: '2 à 4 jours après, prélèvements par un laboratoire accrédité COFRAC.' },
    ]} />
  </Section>
  <Section tone="paper">
    <Split photo={labo} alt="Analyse d'échantillons d'eau en laboratoire" caption="Photo d'illustration.">
      <h2 data-reveal-text>Des interventions contrôlées, analyses à l'appui.</h2>
      <p class="lead muted">Chaque étape est mesurée : concentration, durée de contact, rinçage. La validation finale repose sur des prélèvements analysés par un laboratoire accrédité COFRAC.</p>
    </Split>
  </Section>
  <CtaBand title="Un réseau à désinfecter ?" text="Travaux neufs, résultat d'analyse non conforme : décrivez-nous l'établissement et le réseau, nous préparons le devis de prestation." label="Demander un devis" />
  <Related items={[
    { label: 'Désembouage', desc: 'Circuits de chauffage collectif', href: '/collectif-tertiaire/desembouage/' },
    { label: 'Matériel CLACK', desc: 'Adoucisseurs et filtre magnétique', href: '/collectif-tertiaire/materiel-clack/' },
    { label: 'Collectif & tertiaire', desc: "De l'étude au SAV", href: '/collectif-tertiaire/' },
  ]} />
</Page>
