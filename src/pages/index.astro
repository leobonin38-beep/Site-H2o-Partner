---
import Base from '../layouts/Base.astro';
import { localBusinessLd } from '../lib/schema';
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
---
<Base
  title="Traitement de l'eau en Isère · H2O Partner"
  description="Adoucisseurs, filtration, désembouage et désinfection pour particuliers, installateurs, collectif et industrie. 25 ans d'expérience, à Sillans (Isère)."
  path="/"
  ld={[localBusinessLd(site)]}
>
  <h1>Votre équipier du traitement de l'eau.</h1>
</Base>
