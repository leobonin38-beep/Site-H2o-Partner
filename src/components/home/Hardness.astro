---
// Règle de dureté (logique reprise de la V2) : src/lib/hardness.ts
const marks = [0, 7, 15, 25, 35, 50];
const bands = [
  { from: 0, to: 7, label: 'Très douce' }, { from: 7, to: 15, label: 'Douce' }, { from: 15, to: 25, label: 'Moy. dure' },
  { from: 25, to: 35, label: 'Dure' }, { from: 35, to: 50, label: 'Très dure' },
];
---
<div class="hardness" data-hardness>
  <div class="row">
    <label for="th">Dureté de votre eau</label>
    <output id="th-out" for="th" class="val num"><b>28</b> °f</output>
  </div>
  <input id="th" type="range" min="0" max="50" step="1" value="28" aria-describedby="th-help" />
  <div class="scale" aria-hidden="true">
    {bands.map((b) => <span style={`--w:${b.to - b.from}`}>{b.label}</span>)}
  </div>
  <div class="ticks num" aria-hidden="true">{marks.map((m) => <span style={`--p:${m / 50}`}>{m}</span>)}</div>

  <div class="row row--2">
    <label for="cible">Dureté souhaitée après adoucissement</label>
    <output id="cible-out" for="cible" class="val num"><b>10</b> °f</output>
  </div>
  <input id="cible" type="range" min="0" max="50" step="1" value="10" />

  <dl class="result">
    <div><dt>Votre eau est</dt><dd id="th-classe">dure</dd></div>
    <div><dt>Sodium apporté par l'adoucissement</dt><dd><span id="sodium" class="num">83</span> <small>mg/L</small></dd></div>
  </dl>
  <p id="th-help" class="help">La dureté figure sur votre facture d'eau ou sur le site de votre commune. Repères couramment utilisés ; adoucir de 1 °f apporte en moyenne 4,6 mg de sodium par litre. La réglementation n'exige pas de dureté résiduelle : un installateur qualifié détermine avec vous le bon seuil.</p>
</div>

<script>
  import { initHardness } from '../../scripts/hardness';
  initHardness();
</script>

<style>
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .row--2 { margin-top: 36px; }
  label { font-weight: 600; }
  .val { font-family: var(--f-display); font-size: 2.25rem; line-height: 1; white-space: nowrap; }
  .row label { max-width: 22ch; }
  .val b { font-weight: 380; }
  input[type='range'] { width: 100%; margin: 14px 0 8px; accent-color: var(--accent-strong); height: 28px; cursor: pointer; }
  .scale { display: flex; gap: 2px; }
  .scale span { flex: var(--w); font-size: var(--t-xs); color: var(--muted); padding-top: 6px; border-top: 3px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .scale span:nth-child(4), .scale span:nth-child(5) { border-top-color: var(--accent-strong); }
  .ticks { position: relative; height: 18px; font-size: var(--t-xs); color: var(--muted); margin-top: 4px; }
  .ticks span { position: absolute; left: calc(var(--p) * 100%); transform: translateX(calc(var(--p) * -100%)); }
  .result { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); }
  dt { font-size: var(--t-sm); color: var(--muted); }
  dd { font-family: var(--f-display); font-size: var(--t-xl); line-height: 1.15; margin-top: 4px; }
  dd small { font-family: var(--f-body); font-size: var(--t-sm); }
  .help { margin-top: 20px; font-size: var(--t-xs); color: var(--muted); line-height: 1.55; }
  @media (max-width: 480px) { .scale span { font-size: 0; } .scale span::after { content: ''; } }
</style>
