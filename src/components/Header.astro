---
import Logo from './Logo.astro';
import { NAV, SITE } from '../config/site';
import { url } from '../lib/url';
interface Props { current?: string; overDark?: boolean }
const { current = '/', overDark = false } = Astro.props;
const intros: Record<string, string> = {
  Particuliers: "Un adoucisseur de qualité, posé et suivi par nos partenaires plombiers-chauffagistes.",
  'Collectif & tertiaire': "Étude, matériel, mise en service et entretien pour les réseaux d'eau des bâtiments.",
};
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---
<header class:list={['site-header', { 'over-dark': overDark }]} data-header>
  <div class="bar wrap">
    <Logo />
    <nav class="nav" aria-label="Navigation principale">
      <ul>
        {NAV.map((item) => (
          <li class:list={[{ current: isCurrent(item.href) }]}>
            {item.children ? (
              <>
                <button type="button" class="nav-item" aria-expanded="false" aria-controls={`mega-${slug(item.label)}`} data-mega-trigger>
                  {item.label}<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3.5 5 7l4-3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                </button>
                <div class="mega" id={`mega-${slug(item.label)}`} hidden data-mega>
                  <div class="mega-inner wrap">
                    <div class="mega-intro">
                      <p class="mega-title">{item.label}</p>
                      <p class="mega-text">{intros[item.label]}</p>
                      <a class="link link--accent" href={url(item.href)}>Tout sur {item.label.toLowerCase()}</a>
                    </div>
                    <ul class="mega-links">
                      {item.children.map((c) => (
                        <li><a href={url(c.href)}><span class="mega-link-label">{c.label}</span><span class="mega-link-desc">{c.desc}</span></a></li>
                      ))}
                    </ul>
                  </div>
                </div>
              </>
            ) : (
              <a class="nav-item" href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a class="tel num" href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a>
    <a class="btn header-cta" href={url('/diagnostic/')}>Demander un diagnostic</a>
    <button type="button" class="burger" aria-expanded="false" aria-controls="menu-mobile" data-burger>Menu</button>
  </div>
  <div class="mobile" id="menu-mobile" hidden data-mobile>
    <nav aria-label="Navigation principale (mobile)" class="wrap">
      <ul class="m-list">
        {NAV.map((item) => (
          <li>
            <a class="m-item" href={url(item.href)}>{item.label}</a>
            {item.children && (
              <ul class="m-sub">{item.children.map((c) => <li><a href={url(c.href)}>{c.label}</a></li>)}</ul>
            )}
          </li>
        ))}
        <li><a class="m-item" href={url('/contact/')}>Contact</a></li>
      </ul>
      <div class="m-foot">
        <a class="m-tel num" href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a>
        <a class="btn" href={url('/diagnostic/')}>Demander un diagnostic</a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { initMenus } from '../scripts/menu';
  initMenus();
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--on-dark); transition: transform .45s var(--ease-out), background-color .3s; background: var(--night); }
  .site-header.over-dark:not(.is-solid) { background: transparent; }
  .site-header.is-hidden { transform: translateY(-100%); }
  .site-header.is-solid { box-shadow: 0 1px 0 var(--line-dark); }
  .bar { display: flex; align-items: center; gap: clamp(16px, 2vw, 32px); height: var(--header-h); }
  .nav { margin-left: auto; }
  .nav > ul { display: flex; gap: clamp(14px, 1.6vw, 26px); list-style: none; padding: 0; }
  .nav-item { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; padding: 8px 0; cursor: pointer; font-size: var(--t-sm); text-decoration: none; color: inherit; position: relative; }
  .nav-item::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform .35s var(--ease-out); }
  .nav-item:hover::after, .nav-item[aria-expanded='true']::after, .current > .nav-item::after { transform: scaleX(1); transform-origin: left; }
  .nav-item svg { transition: transform .3s var(--ease-out); }
  .nav-item[aria-expanded='true'] svg { transform: rotate(180deg); }
  .tel { font-size: var(--t-sm); text-decoration: none; white-space: nowrap; opacity: .9; }
  .tel:hover { opacity: 1; }
  .header-cta { min-height: 44px; }
  .burger { display: none; margin-left: auto; min-height: 44px; padding: 0 16px; background: none; color: inherit; border: 1px solid var(--line-dark); border-radius: var(--radius); cursor: pointer; }

  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--night-3); color: var(--on-dark); border-top: 1px solid var(--line-dark); box-shadow: 0 24px 48px rgba(0,0,0,.28); }
  .mega-inner { display: grid; grid-template-columns: 5fr 7fr; gap: 48px; padding: 36px 0 40px; }
  .mega-title { font-family: var(--f-display); font-size: var(--t-xl); line-height: 1.1; }
  .mega-text { margin: 10px 0 18px; color: var(--on-dark-muted); max-width: 40ch; }
  .mega-links { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .mega-links a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line-dark); text-decoration: none; }
  .mega-link-label { display: block; font-weight: 600; transition: color .2s; }
  .mega-link-desc { display: block; font-size: var(--t-sm); color: var(--on-dark-muted); }
  .mega-links a:hover .mega-link-label { color: var(--accent); }

  .mobile { position: fixed; inset: var(--header-h) 0 0; background: var(--night); overflow-y: auto; padding: 16px 0 40px; }
  .m-list { list-style: none; padding: 0; }
  .m-list > li { border-bottom: 1px solid var(--line-dark); padding: 12px 0; }
  .m-item { font-family: var(--f-display); font-size: 1.75rem; line-height: 1.2; text-decoration: none; display: block; padding: 4px 0; }
  .m-sub { list-style: none; padding: 4px 0 4px 2px; }
  .m-sub a { display: block; padding: 8px 0; color: var(--on-dark-muted); text-decoration: none; }
  .m-foot { display: grid; gap: 14px; margin-top: 28px; }
  .m-tel { font-size: 1.5rem; text-decoration: none; }

  @media (max-width: 1180px) { .nav, .tel { display: none; } .header-cta { margin-left: auto; } }
  @media (max-width: 1180px) { .burger { display: inline-flex; align-items: center; margin-left: 0; } }
  @media (max-width: 640px) { .header-cta { display: none; } .burger { margin-left: auto; } }
  :global(html.menu-open) { overflow: hidden; }
</style>
