---
import { url } from '../../lib/url';
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Fil d'Ariane">
  <ol>
    <li><a href={url('/')}>Accueil</a></li>
    {items.map((it, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={url(it.href)}>{it.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-size: var(--t-sm); }
  .crumbs li + li::before { content: '/'; margin: 0 10px; opacity: .45; }
  .crumbs a { color: inherit; text-decoration: none; opacity: .72; transition: opacity .2s; }
  .crumbs a:hover { opacity: 1; }
  .crumbs [aria-current] { color: var(--accent); }
</style>
